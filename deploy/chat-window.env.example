# /etc/arynwood-chat-window/env  (mode 600, owned by root)
# Generate the secret with: python3 -c 'import secrets; print(secrets.token_hex(32))'
CHAT_WINDOW_SECRET=
CHAT_WINDOW_SITES=/etc/arynwood-chat-window/sites
CHAT_WINDOW_DATA=/var/lib/arynwood-chat-window
CHAT_WINDOW_TRUSTED_PROXIES=127.0.0.1,::1
CHAT_WINDOW_CLIENT_IP_HEADER=X-Real-IP
CHAT_WINDOW_MAX_CONCURRENT=1
CHAT_WINDOW_MAX_QUEUE=8
