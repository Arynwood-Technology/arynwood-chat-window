[Unit]
Description=Arynwood Chat Window
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=chatwindow
Group=chatwindow
EnvironmentFile=/etc/arynwood-chat-window/env
ExecStart=/opt/arynwood-chat-window/venv/bin/chat-window serve
Restart=on-failure
RestartSec=5
# The server reads site files and writes only its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/arynwood-chat-window
WorkingDirectory=/var/lib/arynwood-chat-window
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
